{
  "name": "opencode-good-fences",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin that renders fenced code blocks as a borderless box with a language label.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": ["dist"],
  "keywords": ["opencode", "opencode-plugin", "opencode-plugins", "tui", "markdown", "code-blocks"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.1",
    "solid-js": "^1.9.0",
    "typescript": "^7.0.2"
  }
}
